      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Digite a nota:  3\n",
            "Digite a nota:  6\n",
            "Digite a nota:  1\n",
            "Digite a nota:  7\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
